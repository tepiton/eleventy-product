<style>{% include "css/sections/cta.css" %}</style>
<section id="cta" class="section cta-band">
	<div class="container">
		<h2 class="cta-heading">{{ section.data.title }}</h2>
		{%- if section.templateContent and section.templateContent.trim().length %}
		<div class="cta-lede">{{ section.templateContent | safe }}</div>
		{%- endif %}
		{%- if section.data.cta %}
		<div class="cta-actions">
			<a class="button button-large" href="{{ section.data.cta.href }}">{{ section.data.cta.label }}</a>
		</div>
		{%- endif %}
	</div>
</section>
